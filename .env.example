# Supabase project (Project Settings > API). The anon key is public by design; never put the service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Google OAuth web client ID, for native Google sign-in in the Android app.
VITE_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
